# 模型服务 API Key。正式运行 CLI Agent 时必须设置。
API_KEY=""

# OpenAI-compatible 服务地址。默认使用阿里云 DashScope 兼容模式。
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 主推理模型名称。可按你的服务商实际支持情况调整。
MODEL=qvq-max-2025-03-25

# 工具规划模型。建议使用更便宜、更快的小模型。
PLANNER_MODEL=qwen-turbo

# 单次模型请求超时时间，单位为秒。
REQUEST_TIMEOUT=30

# 模型请求失败后的最大重试次数。
MAX_RETRIES=2

# 应用日志级别，可选 DEBUG、INFO、WARNING、ERROR。
LOG_LEVEL=INFO

# 可选：设置后日志写入指定文件；留空则默认写入 ./logs/agent.log。
LOG_FILE=
