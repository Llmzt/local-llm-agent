# 使用官方 Python 3.12 精简镜像作为基础环境
FROM python:3.12-slim

# 设置容器内工作目录
WORKDIR /app

# 不生成 .pyc 文件
ENV PYTHONDONTWRITEBYTECODE=1
# Python 日志实时输出
ENV PYTHONUNBUFFERED=1

# 复制依赖文件
COPY requirements.txt .

# 安装 Python 依赖
RUN pip install --no-cache-dir -r requirements.txt

# 复制项目代码
COPY agent.py cli.py ./
COPY service ./service
COPY skill ./skill

# 创建数据库和日志目录
RUN mkdir -p /app/database /app/logs

# 声明容器监听 8000 端口
EXPOSE 8000

# 启动 FastAPI 服务
CMD ["uvicorn", "service.api.api:app", "--host", "0.0.0.0", "--port", "8000"]
